# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*

# package manager lockfiles (use pnpm only)
package-lock.json

# dev server logs
dev-server.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# playwright mcp
.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts
install.log
